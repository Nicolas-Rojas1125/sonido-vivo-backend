          "mode": "raw",
          "raw": "{\n  \"codigo\": \"GA006\",\n  \"categoria\": \"guitarras-acusticas\",\n  \"nombre\": \"Guitarra de Prueba\",\n  \"marca\": \"Yamaha\",\n  \"modelo\": \"FG800\",\n  \"precio\": 199990,\n  \"stock\": 4,\n  \"descripcion\": \"Guitarra creada desde Postman.\"\n}",
