{
  "info": {
    "name": "Sonido Vivo - ms-tienda (8083)",
    "description": "Necesita ms-usuarios encendido para el login (el token se pide al puerto 8081).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Login ADMINISTRADOR (guarda el token)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:8081/api/auth/login",
        "description": "Guarda el accessToken en la variable {{token}} de la colección.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo\": \"admin@sonidovivo.cl\",\n  \"clave\": \"Admin123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Guarda el token para usarlo en las demás peticiones de la colección",
              "if (pm.response.code === 200 || pm.response.code === 201) {",
              "    pm.collectionVariables.set('token', pm.response.json().accessToken);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Listar productos",
      "request": {
        "method": "GET",
        "header": [],
        "url": "http://localhost:8083/api/productos"
      }
    },
    {
      "name": "3. Ver producto GA001",
      "request": {
        "method": "GET",
        "header": [],
